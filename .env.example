# Copy to .env.local and fill in the blanks. Never commit real keys: .gitignore
# ignores every .env file except this one.
# NEXT_PUBLIC_ values are sent to the browser. CLERK_SECRET_KEY stays on the server.
# next.config.ts builds the Content-Security-Policy from the Clerk key and Supabase
# URL, so restart `npm run dev` (or rebuild) after changing them.

# Supabase: Dashboard > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clerk: Dashboard > Configure > API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk routes (these match the pages in src/app)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app
